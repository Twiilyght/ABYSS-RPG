<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abyss - Hub de Campanhas</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght=400;700&family=Oswald:wght=500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #050507;
            --bg-gradient-top: #050507;
            --bg-gradient-bottom: #12071c;
            --panel-bg: rgba(21, 21, 26, 0.95);
            --primary-purple: #7b1fa2;
            --light-purple: #bc4ed8;
            --text-gold: #d4af37;
            --text-light: #f0f0f0;
            --border-color: #4a3427;
            --font-rpg: 'Cinzel', serif; 
            --font-text: 'Oswald', sans-serif;
        }

        * { box-sizing: border-box; }
        
        @keyframes popIn {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        body { 
            background-color: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 15% 25%, color-mix(in srgb, var(--primary-purple) 15%, transparent) 0%, transparent 50%),
                radial-gradient(circle at 85% 35%, color-mix(in srgb, var(--primary-purple) 12%, transparent) 0%, transparent 45%),
                linear-gradient(180deg, var(--bg-gradient-top) 0%, color-mix(in srgb, var(--bg-gradient-bottom) 30%, var(--bg-dark)) 40%, var(--bg-gradient-bottom) 70%, var(--bg-gradient-top) 100%);
            background-attachment: fixed;
            background-size: cover;
            color: var(--text-light);
            font-family: var(--font-rpg);
            margin: 0;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .container { 
            width: 100%;
            max-width: 1100px; 
            padding: 40px 20px; 
            animation: popIn 0.4s ease-out;
        }

        .title { 
            color: var(--primary-purple); 
            text-shadow: 0 0 20px rgba(123, 31, 162, 0.5); 
            letter-spacing: 8px; 
            font-size: 2.5rem; 
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 50px;
        }

        .section-box { 
            background: var(--panel-bg); 
            border: 1px solid var(--border-color); 
            margin-bottom: 40px; 
            padding: 40px 30px 30px; 
            border-radius: 8px; 
            position: relative;
            box-shadow: 0 4px 25px rgba(0,0,0,0.7);
        }

        .section-title { 
            position: absolute; 
            top: -14px; 
            left: 25px; 
            background: var(--bg-dark); 
            padding: 0 15px; 
            color: var(--text-gold); 
            font-size: 1.1rem; 
            letter-spacing: 2px; 
            text-transform: uppercase; 
            border: 1px solid var(--border-color);
            border-radius: 4px;
        }

        .campaign-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .create-campaign-box {
            background: linear-gradient(135deg, rgba(123, 31, 162, 0.2) 0%, rgba(74, 14, 99, 0.4) 100%);
            border: 2px dashed var(--light-purple);
            border-radius: 12px;
            height: 180px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .create-campaign-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 20px rgba(188, 78, 216, 0.4);
            border-style: solid;
            background: rgba(123, 31, 162, 0.3);
        }

        .create-campaign-box span.icon { font-size: 3rem; margin-bottom: 5px; line-height: 1; }
        .create-campaign-box span.text { font-size: 1.2rem; letter-spacing: 1.5px; font-weight: bold; text-transform: uppercase; }

        .campaign-card {
            background-color: #0c0c10;
            background-size: cover;
            background-position: center;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            position: relative;
            overflow: hidden;
            box-shadow: inset 0 -80px 60px -10px rgba(0,0,0,0.95); /* Gradiente escuro embaixo para o texto aparecer */
        }

        .campaign-card-content {
            padding: 15px;
            position: relative;
            z-index: 2;
        }

        .campaign-card h3 { margin: 0; font-size: 1.3rem; color: var(--text-gold); text-shadow: 1px 1px 3px #000; }
        .campaign-card p { font-family: var(--font-text); color: #ddd; font-size: 0.9rem; margin: 3px 0; text-shadow: 1px 1px 2px #000;}
        .campaign-id { font-size: 0.8rem !important; color: var(--light-purple) !important; margin-bottom: 8px !important;}

        .campaign-card .actions { display: flex; gap: 8px; margin-top: 10px; }

        .btn-small {
            background: rgba(0, 0, 0, 0.6); border: 1px solid var(--primary-purple); color: var(--text-light);
            font-family: var(--font-text); padding: 6px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; transition: 0.2s; flex: 1;
            backdrop-filter: blur(2px);
        }
        .btn-small:hover { background: var(--primary-purple); }
        .btn-delete:hover { background: #8b0000; border-color: #ff4c4c; }

        .btn-primary { background: var(--primary-purple); color: #fff; border: none; padding: 12px 25px; font-family: var(--font-rpg); cursor: pointer; border-radius: 4px; font-weight: bold; width: 100%; margin-top: 10px; transition: 0.2s;}
        .btn-primary:hover { background: var(--light-purple); box-shadow: 0 0 15px var(--primary-purple); }

        .btn-secondary { background: #0c0c10; border: 1px solid var(--border-color); color: #aaa; padding: 12px 25px; cursor: pointer; font-family: var(--font-rpg); border-radius: 6px; font-weight: bold; width: 100%; transition: 0.2s; margin-top: 10px;}
        .btn-secondary:hover { background: rgba(255,255,255,0.1); color: #fff; }

        .btn-large { font-size: 1.1rem; letter-spacing: 2px; text-transform: uppercase; padding: 15px 30px; }
        
        .center-action { display: flex; justify-content: center; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(74, 52, 39, 0.3); }

        /* MODAIS ESTILO ARCADO/SOMBRIO */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(4px);
            display: flex; justify-content: center; align-items: center;
            z-index: 1000; animation: fadeIn 0.3s;
        }

        .modal-content {
            background: #0d0d12; border: 1px solid var(--primary-purple);
            padding: 30px; border-radius: 8px; width: 90%; max-width: 450px;
            box-shadow: 0 0 30px rgba(123, 31, 162, 0.4); text-align: center;
        }

        .modal-content h2 { color: var(--text-gold); margin-top: 0; font-size: 1.5rem; letter-spacing: 2px;}
        
        .input-text {
            background: rgba(0,0,0,0.6); border: 1px solid #333; color: #fff; 
            font-family: var(--font-text); font-size: 1rem; padding: 12px 15px; 
            border-radius: 4px; outline: none; width: 100%; margin-bottom: 15px;
            transition: 0.3s;
        }
        .input-text:focus { border-color: var(--light-purple); box-shadow: 0 0 10px rgba(188, 78, 216, 0.2);}

        .modal-actions { display: flex; gap: 15px; margin-top: 10px; }

        .hidden { display: none !important; }
        .error-msg { color: #ff4c4c; font-family: var(--font-text); font-size: 0.9rem; margin-bottom: 15px; display: none; }

    </style>
</head>
<body>

<div class="container">
    <h1 class="title">Portal do Abismo</h1>

    <!-- ÁREA DO MESTRE -->
    <section class="section-box">
        <div class="section-title">O Mestre (Criações)</div>
        <div class="campaign-grid" id="master-grid">
            <div class="create-campaign-box" id="btn-open-create">
                <span class="icon">+</span>
                <span class="text">Forjar Campanha</span>
            </div>
        </div>
        <div class="center-action">
            <button class="btn-secondary btn-large" id="btn-open-join">Entrar em Campanha</button>
        </div>
    </section>

    <!-- ÁREA DO JOGADOR -->
    <section class="section-box">
        <div class="section-title">O Jogador (Vínculos)</div>
        <div class="campaign-grid" id="player-grid"></div>
    </section>
</div>

<!-- MODAL: CRIAR CAMPANHA -->
<div id="modal-create" class="modal-overlay hidden">
    <div class="modal-content">
        <h2>Forjar Nova Campanha</h2>
        <input type="text" id="input-camp-name" class="input-text" placeholder="Nome da Campanha (Ex: Segredos do Abismo)">
        <input type="text" id="input-camp-desc" class="input-text" placeholder="Descrição (Ex: Sextas às 20h)">
        <input type="text" id="input-camp-banner" class="input-text" placeholder="URL da Imagem de Fundo (Opcional)">
        <p id="create-error" class="error-msg">Preencha o nome da campanha.</p>
        <div class="modal-actions">
            <button class="btn-secondary" id="btn-cancel-create">Cancelar</button>
            <button class="btn-primary" id="btn-confirm-create">Forjar</button>
        </div>
    </div>
</div>

<!-- MODAL: ENTRAR EM CAMPANHA -->
<div id="modal-join" class="modal-overlay hidden">
    <div class="modal-content">
        <h2>Conectar ao Ritual</h2>
        <p style="font-family: var(--font-text); color: #aaa; font-size: 0.9rem; margin-bottom: 20px;">Insira o ID fornecido pelo Mestre da mesa.</p>
        <input type="text" id="input-join-id" class="input-text" placeholder="ID da Campanha" style="text-transform: uppercase;">
        <p id="join-error" class="error-msg"></p>
        <div class="modal-actions">
            <button class="btn-secondary" id="btn-cancel-join">Cancelar</button>
            <button class="btn-primary" id="btn-confirm-join">Conectar</button>
        </div>
    </div>
</div>

<script>
    let masterCampaigns = JSON.parse(localStorage.getItem('masterCampaigns')) || [];
    let playerCampaigns = JSON.parse(localStorage.getItem('playerCampaigns')) || [];

    const masterGrid = document.getElementById('master-grid');
    const playerGrid = document.getElementById('player-grid');
    const btnOpenCreate = document.getElementById('btn-open-create');

    // Elementos Modais
    const modalCreate = document.getElementById('modal-create');
    const modalJoin = document.getElementById('modal-join');

    function generateID() {
        return Math.random().toString(36).substr(2, 6).toUpperCase();
    }

    function saveData() {
        localStorage.setItem('masterCampaigns', JSON.stringify(masterCampaigns));
        localStorage.setItem('playerCampaigns', JSON.stringify(playerCampaigns));
        renderCampaigns();
    }

    function renderCampaigns() {
        masterGrid.innerHTML = '';
        masterGrid.appendChild(btnOpenCreate); 
        playerGrid.innerHTML = ''; 

        // Render Mestre
        masterCampaigns.forEach((camp, index) => {
            const card = document.createElement('div');
            card.className = 'campaign-card';
            if(camp.banner) card.style.backgroundImage = `url('${camp.banner}')`;

            card.innerHTML = `
                <div class="campaign-card-content">
                    <h3>${camp.name}</h3>
                    <p class="campaign-id">ID: ${camp.id}</p>
                    <p>${camp.desc}</p>
                    <div class="actions">
                        <button class="btn-small" onclick="copyInvite('${camp.id}')">Convite</button>
                        <button class="btn-small" onclick="addSheetMaster()">Add Ficha</button>
                        <button class="btn-small btn-delete" onclick="deleteMasterCampaign(${index})">X</button>
                    </div>
                </div>
            `;
            masterGrid.appendChild(card);
        });

        btnOpenCreate.style.display = masterCampaigns.length >= 6 ? 'none' : 'flex';

        // Render Jogador
        if (playerCampaigns.length === 0) {
            playerGrid.innerHTML = '<p style="font-family: var(--font-text); color: #666; font-style: italic;">Nenhum vínculo estabelecido.</p>';
        } else {
            playerCampaigns.forEach((camp, index) => {
                const card = document.createElement('div');
                card.className = 'campaign-card';
                card.style.border = '1px solid #333';
                
                card.innerHTML = `
                    <div class="campaign-card-content">
                        <h3>Campanha #${camp.id}</h3>
                        <p>ID Vínculo: ${camp.id}</p>
                        <div class="actions">
                            <button class="btn-small">Abrir Ficha</button>
                            <button class="btn-small btn-delete" onclick="leavePlayerCampaign(${index})">Sair</button>
                        </div>
                    </div>
                `;
                playerGrid.appendChild(card);
            });
        }
    }

    // LÓGICA DO MODAL: CRIAR
    btnOpenCreate.addEventListener('click', () => {
        document.getElementById('input-camp-name').value = '';
        document.getElementById('input-camp-desc').value = '';
        document.getElementById('input-camp-banner').value = '';
        document.getElementById('create-error').style.display = 'none';
        modalCreate.classList.remove('hidden');
    });

    document.getElementById('btn-cancel-create').addEventListener('click', () => {
        modalCreate.classList.add('hidden');
    });

    document.getElementById('btn-confirm-create').addEventListener('click', () => {
        const name = document.getElementById('input-camp-name').value.trim();
        const desc = document.getElementById('input-camp-desc').value.trim();
        const banner = document.getElementById('input-camp-banner').value.trim();
        const errorMsg = document.getElementById('create-error');

        if (!name) {
            errorMsg.style.display = 'block';
            return;
        }

        masterCampaigns.push({
            id: generateID(),
            name: name,
            desc: desc || "Sem descrição...",
            banner: banner
        });

        saveData();
        modalCreate.classList.add('hidden');
    });

    // LÓGICA DO MODAL: ENTRAR
    document.getElementById('btn-open-join').addEventListener('click', () => {
        document.getElementById('input-join-id').value = '';
        document.getElementById('join-error').style.display = 'none';
        modalJoin.classList.remove('hidden');
    });

    document.getElementById('btn-cancel-join').addEventListener('click', () => {
        modalJoin.classList.add('hidden');
    });

    document.getElementById('btn-confirm-join').addEventListener('click', () => {
        const inputId = document.getElementById('input-join-id').value.trim().toUpperCase();
        const errorMsg = document.getElementById('join-error');

        if (!inputId) {
            errorMsg.innerText = "Insira um ID válido.";
            errorMsg.style.display = 'block';
            return;
        }

        // Verifica se o mestre está tentando entrar na própria mesa
        const isMaster = masterCampaigns.some(camp => camp.id === inputId);
        if (isMaster) {
            errorMsg.innerText = "Você é o Mestre desta campanha. Acesse-a pelo painel superior.";
            errorMsg.style.display = 'block';
            return;
        }

        // Verifica se já participa
        const isAlreadyPlayer = playerCampaigns.some(camp => camp.id === inputId);
        if (isAlreadyPlayer) {
            errorMsg.innerText = "Você já está participando desta campanha.";
            errorMsg.style.display = 'block';
            return;
        }

        playerCampaigns.push({ id: inputId });
        saveData();
        modalJoin.classList.add('hidden');
    });

    // AÇÕES DOS BOTÕES INTERNOS
    window.copyInvite = function(id) {
        navigator.clipboard.writeText(id).then(() => alert(`ID (${id}) copiado!`));
    };

    window.deleteMasterCampaign = function(index) {
        if(confirm("Destruir esta campanha para sempre?")) {
            masterCampaigns.splice(index, 1);
            saveData();
        }
    };

    window.leavePlayerCampaign = function(index) {
        if(confirm("Romper vínculo com esta campanha?")) {
            playerCampaigns.splice(index, 1);
            saveData();
        }
    };

    window.addSheetMaster = function() {
        alert("Lógica para o Mestre vincular fichas de NPCs ou monstros aqui.");
    };

    // Fechar modais ao clicar fora
    window.onclick = function(event) {
        if (event.target === modalCreate) modalCreate.classList.add('hidden');
        if (event.target === modalJoin) modalJoin.classList.add('hidden');
    }

    renderCampaigns();
</script>
</body>
</html>
